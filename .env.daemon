# PostgreSQL connection (not used directly by daemon; Hono API handles DB)
DATABASE_URL=postgresql://recipe_app_user:123@localhost:5432/recipe_app

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b-instruct-q8_0
OLLAMA_TIMEOUT=120

# ComfyUI
COMFYUI_URL=http://localhost:8188
COMFYUI_TIMEOUT=300

# Cloudflare R2
R2_ENDPOINT_URL=https://dummyaccount.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=recipe-assets
R2_UPLOAD_TIMEOUT=60

# Hono API
HONO_API_URL=http://localhost:3000
HONO_API_TIMEOUT=30

# Pipeline
CONCURRENCY_LIMIT=1
TEMP_DIR=/tmp/sync-daemon
LOG_LEVEL=INFO

